<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_webusb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.webusb</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_connected_devices_section']" position="inside">
                <setting id="pos_webusb_printer_setting" help="Cetak struk thermal kasir langsung via USB dari browser (WebUSB) tanpa popup window.print">
                    <field name="pos_use_webusb_printer"/>
                    <div class="content-group mt16" invisible="not pos_use_webusb_printer">
                        <div class="row mt8">
                            <label for="pos_webusb_paper_width" string="Lebar Kertas" class="col-lg-4 o_light_label"/>
                            <field name="pos_webusb_paper_width" class="col-lg-6"/>
                        </div>
                        <div class="mt8">
                            <field name="pos_webusb_auto_cut" class="oe_inline"/>
                            <label for="pos_webusb_auto_cut" string="Auto Cut Kertas (GS V)" class="oe_inline ms-1"/>
                        </div>
                        <div class="mt8">
                            <field name="pos_webusb_open_cashbox" class="oe_inline"/>
                            <label for="pos_webusb_open_cashbox" string="Buka Laci Kasir (Cash Drawer via RJ11)" class="oe_inline ms-1"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
